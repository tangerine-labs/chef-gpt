# Written by scripts/setup-supabase.sh — never commit .env
SUPABASE_ORG_ID=
SUPABASE_REGION=eu-central-1
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_DB_PASSWORD=
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_DB_PASSWORD=
# Dev project (what local tooling and Spike B talk to)
SUPABASE_URL=https://<dev-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public MCP endpoint; mcp-use bakes it into the view bundle (CSP) at build time.
# At runtime the edge function derives it from SUPABASE_URL, which Supabase injects.
MCP_URL=https://<dev-ref>.supabase.co/functions/v1/chef/mcp
# Google OAuth client (pasted into Supabase → Auth → Providers → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the auth site (GitHub Pages); Supabase Site URL must equal this
SITE_URL=https://<github-user>.github.io/chef-gpt
TEST_USER_PASSWORD=   # for server/tools_test.ts; any long random string
